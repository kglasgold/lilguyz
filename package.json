{
  "name": "assistant-bot",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node server/index.js",
    "build": "vite build",
    "check": "node --check server/index.js && node --check server/watchStore.js && node --check server/parseWatch.js && node --check scripts/dev.js && vite build",
    "electron": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@linear/sdk": "^82.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^5.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.assistant-bot.app",
    "productName": "assistant-bot",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "assets/**/*",
      "data/**/*",
      "node_modules/**/*",
      ".env"
    ],
    "directories": {
      "output": "dist-electron"
    }
  }
}
